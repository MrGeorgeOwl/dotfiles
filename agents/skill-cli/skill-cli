def list_installed() -> dict[str, dict[str, Path | None]]:
    result: dict[str, dict[str, Path | None]] = {}
    for label, root in list_skill_roots().items():
        entries: dict[str, Path | None] = {}
        if root.is_dir():
            for item in root.iterdir():
                if item.name.startswith(".") or not item.is_dir():
                    continue
                skill = item / "SKILL.md"
                entries[item.name] = skill if skill.is_file() else None
        result[label] = entries
    return result


def parse_day(ts) -> str | None:
    if isinstance(ts, (int, float)):
        try:
            return datetime.datetime.fromtimestamp(
                ts / (1000 if ts > 1e12 else 1)
            ).strftime("%Y-%m-%d")
        except (OverflowError, OSError, ValueError):
            return None
    text = str(ts or "")[:10]
    return text if re.match(r"\d{4}-\d\d-\d\d$", text) else None


class Usage:
    def __init__(self) -> None:
        self.files = 0
        self.first: str | None = None
        self.last: str | None = None
        self.loads: collections.Counter = collections.Counter()
        self.last_use: dict[str, str] = {}
        self.seen: set = set()

    def saw(self, ts) -> None:
        t = parse_day(ts)
        if t:
            self.first = min(self.first or t, t)
            self.last = max(self.last or t, t)

    def add(self, skill, ts, key) -> None:
        if not skill or key is None or key in self.seen:
            return
        self.seen.add(key)
        skill = skill.split(":")[-1]
        self.loads[skill] += 1
        t = parse_day(ts)
        if t:
            self.last_use[skill] = max(self.last_use.get(skill, t), t)


def read_records(pattern: Path):
    for name in glob.glob(str(pattern), recursive=True):
        try:
            with open(name, errors="replace") as fh:
                for line in fh:
                    try:
                        yield name, line, json.loads(line)
                    except ValueError:
                        yield name, line, None
        except OSError:
            continue


def extract_text(content) -> str:
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return " ".join(x.get("text", "") for x in content if isinstance(x, dict))
    return ""


def parse_skill_path(path) -> str | None:
    match = SKILL_PATH.search(str(path))
    return match.group(1) if match else None


def scan(usage: Usage, pattern: Path, handle) -> None:
    files: set[str] = set()
    for name, line, record in read_records(pattern):
        files.add(name)
        if isinstance(record, dict):
            handle(usage, name, line, record)
    usage.files += len(files)


def parse_claude_record(u, name, line, r) -> None:
    ts = r.get("timestamp")
    u.saw(ts)
    content = (r.get("message") or {}).get("content")
    if r.get("type") == "assistant" and isinstance(content, list):
        for block in content:
            if not isinstance(block, dict) or block.get("type") != "tool_use":
                continue
            args = block.get("input") or {}
            if block.get("name") == "Skill":
                u.add(args.get("skill"), ts, block.get("id"))
            elif block.get("name") == "Read":
                u.add(parse_skill_path(args.get("file_path", "")), ts, block.get("id"))
    elif r.get("type") == "user":
        match = re.search(
            r"<command-name>/?([A-Za-z0-9:_-]+)</command-name>", extract_text(content)
        )
        if match:
            u.add(match.group(1), ts, r.get("uuid"))


def parse_codex_record(u, name, line, r) -> None:
    ts = r.get("timestamp")
    u.saw(ts)
    payload = r.get("payload") or {}
    if payload.get("type") != "function_call" or "SKILL.md" not in line:
        return
    try:
        args = json.loads(payload.get("arguments") or "{}")
        cmd = args.get("cmd") or args.get("command") or ""
    except (ValueError, AttributeError):
        cmd = payload.get("arguments") or ""
    if isinstance(cmd, list):
        cmd = " ".join(map(str, cmd))
    if re.search(r"\b(cat|sed|head|nl|bat|less|tail)\b", cmd) and "find " not in cmd:
        for match in SKILL_PATH.finditer(cmd):
            u.add(match.group(1), ts, (payload.get("call_id"), match.group(1)))


def parse_pi_record(u, name, line, r) -> None:
    ts = r.get("timestamp")
    u.saw(ts)
    msg = r.get("message") or {}
    content = msg.get("content")
    if msg.get("role") == "assistant" and isinstance(content, list):
        for block in content:
            if isinstance(block, dict) and block.get("type") == "toolCall" and block.get("name") == "read":
                path = str((block.get("arguments") or {}).get("path", ""))
                if path.endswith("SKILL.md"):
                    u.add(parse_skill_path(path), ts, block.get("id"))
    elif msg.get("role") == "toolResult":
        match = re.search(
            r"\[Skill file: [^\]]*?/([^/\]]+)/SKILL\.md\]", json.dumps(content)
        )
        if match:
            u.add(match.group(1), ts, msg.get("toolCallId"))
    elif msg.get("role") == "user":
        match = re.match(r"\s*/skill:([A-Za-z0-9._-]+)", extract_text(content))
        if match:
            u.add(match.group(1), ts, (name, ts))


def parse_grok_record(u, name, line, r) -> None:
    ts = r.get("timestamp")
    u.saw(ts)
    update = (r.get("params") or {}).get("update") or {}
    if update.get("sessionUpdate") == "tool_call":
        raw = json.dumps(update.get("rawInput") or update.get("title") or "")
        u.add(parse_skill_path(raw), ts, update.get("toolCallId"))


def count_usage_by_agent() -> dict[str, Usage]:
    claude = resolve_home_var("CLAUDE_HOME", ".claude")
    codex = resolve_home_var("CODEX_HOME", ".codex")
    sources = {
        "claude": [(claude / "projects/**/*.jsonl", parse_claude_record)],
        "codex": [
            (codex / "sessions/**/*.jsonl", parse_codex_record),
            (codex / "archived_sessions/*.jsonl", parse_codex_record),
        ],
        "pi": [(resolve_home_var("PI_HOME", ".pi") / "agent/sessions/**/*.jsonl", parse_pi_record)],
        "omp": [(Path.home() / ".omp/agent/sessions/**/*.jsonl", parse_pi_record)],
        "grok": [(resolve_home_var("GROK_HOME", ".grok") / "sessions/**/updates.jsonl", parse_grok_record)],
    }
    result: dict[str, Usage] = {}
    for agent, parts in sources.items():
        usage = Usage()
        for pattern, handle in parts:
            scan(usage, pattern, handle)
        result[agent] = usage
    return result


def build_report(paths: Paths) -> dict:
    registry = read_registry(paths)
    copies = list_installed()
    usage = count_usage_by_agent()
    newest = max((u.last for u in usage.values() if u.last), default=None)
    cutoff = None
    if newest:
        cutoff = (
            datetime.date.fromisoformat(newest) - datetime.timedelta(days=DORMANT_DAYS)
        ).isoformat()

    def summarize_usage(name: str) -> dict:
        loads = {agent: u.loads[name] for agent, u in usage.items() if u.loads[name]}
        last = max((u.last_use[name] for u in usage.values() if name in u.last_use), default=None)
        if not newest:
            state = "unknown"
        elif last and last >= cutoff:
            state = "active"
        else:
            state = "dormant"
        return {"loads": loads, "total": sum(loads.values()), "last_used": last, "usage": state}

    skills: list[dict] = []
    declared: set[str] = set()

    def append_skill(
        name: str, skill_md: Path | None, fields: dict, problems: list[str], evals: bool
    ) -> None:
        declared.add(name)
        repo_hash = hash_file(skill_md) if skill_md and skill_md.is_file() else None
        raw_src = fields.get("source")
        src = raw_src if isinstance(raw_src, dict) else None
        where = {}
        for label in resolve_agents(fields):
            entries = copies.get(label, {})
            if name not in entries:
                where[label] = "missing"
            elif entries[name] is None:
                where[label] = "hollow"
            elif repo_hash is None:
                where[label] = "not fetched" if src else "ok"
            else:
                where[label] = "ok" if hash_file(entries[name]) == repo_hash else "drift"
        skills.append({
            "name": name,
            "status": fields.get("status", "unregistered"),
            "source": src if src and src.get("url") else src,
            "problems": problems,
            "hash": repo_hash,
            "copies": where,
            "evals": evals,
            **summarize_usage(name),
        })

    for skill in list_repo_skills(paths):
        fields = registry.get(skill.name, {})
        path = skill / "SKILL.md"
        append_skill(
            skill.name,
            path if path.is_file() else None,
            fields,
            find_problems(skill),
            (skill / "evals").is_dir(),
        )

    for name, fields in sorted(registry.items()):
        if name in declared:
            continue
        src = fields.get("source")
        if not isinstance(src, dict):
            continue
        cached = peek_external_skill_dir(name, src)
        problems: list[str] = []
        if not src.get("url"):
            problems.append("source.url missing")
        else:
            try:
                parse_git_url(str(src["url"]))
            except FetchError as exc:
                problems.append(str(exc))
        problem = pin_problem(src.get("pin"))
        if problem:
            problems.append(problem)
        append_skill(
            name,
            (cached / "SKILL.md") if cached else None,
            fields,
            problems,
            False,
        )

    orphans = []
    for label, entries in copies.items():
        for name, path in sorted(entries.items()):
            if name in declared:
                continue
            orphans.append({
                "name": name,
                "root": str(list_skill_roots()[label]),
                "agent": label,
                "hollow": path is None,
                **summarize_usage(name),
            })

    logs = {
        agent: {"files": u.files, "first": u.first, "last": u.last}
        for agent, u in usage.items()
    }
    return {
        "host": os.uname().nodename,
        "entrypoint": str(paths.agents_dir),
        "logs": logs,
        "dormant_after_days": DORMANT_DAYS,
        "skills": skills,
        "orphans": orphans,
    }


def print_report(rep: dict) -> None:
    print(f"{PROG} on {rep['host']}: {len(rep['skills'])} skills in {rep['entrypoint']}")
    print("logs:")
    for agent, loginfo in rep["logs"].items():
        window = f"{loginfo['first']} .. {loginfo['last']}" if loginfo["files"] else "no logs"
        print(f"  {agent:7} {loginfo['files']:>4} files  {window}")
    print(
        f"\n{'skill':24} {'registry':12} {'usage':8} {'loads':>5}  "
        f"{'last used':10}  copies / notes"
    )
    for s in rep["skills"]:
        bad = [f"{agent} {state}" for agent, state in s["copies"].items() if state != "ok"]
        notes = bad or ["all copies ok"]
        notes += s["problems"] + (["evals"] if s["evals"] else [])
        src = s.get("source")
        if isinstance(src, dict) and src.get("url"):
            note = f"external:{src['url']}@{src.get('pin', '')}"
            if src.get("path"):
                note += f" path={src['path']}"
            notes.append(note)
        print(
            f"{s['name']:24} {s['status']:12} {s['usage']:8} {s['total']:>5}  "
            f"{s['last_used'] or '-':10}  {', '.join(notes)}"
        )
    if rep["orphans"]:
        print("\ninstalled but not in the registry (left alone by sync):")
        for o in rep["orphans"]:
            tags = [o["agent"]] + (["no SKILL.md"] if o["hollow"] else [])
            print(
                f"  {o['name']:22} {o['usage']:8} {o['total']:>5}  "
                f"{o['last_used'] or '-':10}  {', '.join(tags)}"
            )
    print(
        f"\nusage: active = loaded within {DORMANT_DAYS} days of the newest log day; "
        "dormant = not; unknown = no logs.\n"
        "Zero loads only means zero inside the log window above."
    )


def cmd_status(paths: Paths, args: argparse.Namespace) -> int:
    rep = build_report(paths)
    if args.json:
        print(json.dumps(rep, indent=1))
    else:
        print_report(rep)
    return 0


# --- eval -----------------------------------------------------------------

def cmd_eval(paths: Paths, args: argparse.Namespace) -> int:
    name = validate_name(args.name)
    skill_dir = skill_path_for(paths, name)
    evals = skill_dir / "evals"
    runner = evals / "run"
    if not (skill_dir / "SKILL.md").is_file():
        print(f"{PROG}: no skill named {name!r}", file=sys.stderr)
        return 2
    if not os.access(runner, os.X_OK):
        print(f"{PROG}: {runner} is missing or not executable", file=sys.stderr)
        return 2
    env = dict(os.environ, SKILL_DIR=str(skill_dir))
    return subprocess.run([str(runner), *args.rest], cwd=evals, env=env).returncode


# --- main -----------------------------------------------------------------

def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog=PROG, description=__doc__.split("\n\n")[0],
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "--entrypoint",
        help="path to the repo agents/ folder (overrides config and env)",
    )
    sub = parser.add_subparsers(dest="command")

    sync = sub.add_parser("sync", help="copy agents/skills and agent config to local dirs")
    sync.add_argument("--dry-run", action="store_true")

    status = sub.add_parser("status", help="report usage, drift, orphans")
    status.add_argument("--json", action="store_true")

    sub.add_parser("check", help="lint skills.yaml (write nothing)")

    reg = sub.add_parser("registry", help="regenerate skills.yaml from SKILL.md files")
    reg.add_argument("--check", action="store_true", help="check only; write nothing")

    add = sub.add_parser("add", help="create a local skill or register an external one")
    add.add_argument("name", help="skill name (lowercase-hyphen)")
    add.add_argument("--source", help="git URL for an external skill")
    add.add_argument("--pin", help="40-char commit SHA")
    add.add_argument("--path", help="subdir inside the repo that contains SKILL.md")

    rem = sub.add_parser("remove", help="delete skill folder + registry entry (repo only)")
    rem.add_argument("name")

    ev = sub.add_parser("eval", help="run a skill's local evals/run")
    ev.add_argument("name")
    ev.add_argument("rest", nargs=argparse.REMAINDER)

    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    paths = Paths.from_entrypoint(resolve_entrypoint(args.entrypoint))
    if args.command is None:
        return cmd_status(paths, argparse.Namespace(json=False))
    handlers = {
        "sync": cmd_sync,
        "status": cmd_status,
        "check": cmd_check,
        "registry": cmd_registry,
        "add": cmd_add,
        "remove": cmd_remove,
        "eval": cmd_eval,
    }
    return handlers[args.command](paths, args)


if __name__ == "__main__":
    sys.exit(main())
