#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Manage shared agent skills. One CLI for sync, status, registry, and evals.

  skill-cli sync [--dry-run]          copy skills (local + external) to agent dirs
  skill-cli status [--json]           usage, drift, orphans on this machine
  skill-cli check                     lint skills.yaml (for tests/CI)
  skill-cli registry                  regenerate skills.yaml; keep human fields
  skill-cli add NAME                  create agents/skills/NAME + register
  skill-cli add NAME --source URL --pin REF [--path SUB]
                                  register an external skill (git fetch at sync)
  skill-cli remove NAME               delete folder + registry entry (repo only)
  skill-cli eval NAME [args]          run skills/NAME/evals/run with SKILL_DIR set

Config: ${XDG_CONFIG_HOME:-~/.config}/skill-cli/config.toml
  entrypoint = "/path/to/dotfiles/agents"

Override with --entrypoint or SKILL_CLI_ENTRYPOINT. OS-agnostic (macOS + Linux).
Copies files; never symlinks. Only sync changes local agent dirs.
External skills live in skills.yaml under source.url / source.pin [/ source.path];
fetched into ${XDG_CACHE_HOME:-~/.cache}/skill-cli/ and never vendored into the repo.
"""

from __future__ import annotations

import argparse
import collections
import datetime
import glob
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import tomllib
from pathlib import Path

PROG = "skill-cli"
HUMAN_FIELDS = ("status", "purpose", "source", "agents")
SHA_RE = re.compile(r"^[0-9a-f]{40}$")
STATUSES = ("active", "experimental", "deprecated")
NAME_RE = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")
SKILL_PATH = re.compile(r"/([A-Za-z0-9._:~-]+)/SKILL\.md")
DORMANT_DAYS = 60
SYNCED = ("agents", "codex", "claude", "grok")
OBSERVED = ("pi", "omp")

# Set by configure() after entrypoint resolution.
AGENTS_DIR: Path
REPO_ROOT: Path
SKILLS_DIR: Path
REGISTRY: Path


# --- paths ----------------------------------------------------------------

def home() -> Path:
    return Path.home()


def resolve_home(var: str, default: str) -> Path:
    return Path(os.environ[var]) if os.environ.get(var) else home() / default


def xdg_config() -> Path:
    return resolve_home("XDG_CONFIG_HOME", ".config")


def xdg_data() -> Path:
    return resolve_home("XDG_DATA_HOME", ".local/share")


def xdg_cache() -> Path:
    return resolve_home("XDG_CACHE_HOME", ".cache")


def config_dir() -> Path:
    return xdg_config() / "skill-cli"


def list_skill_roots() -> dict[str, Path]:
    return {
        "agents": resolve_home("AGENTS_HOME", ".agents") / "skills",
        "codex": resolve_home("CODEX_HOME", ".codex") / "skills",
        "claude": resolve_home("CLAUDE_HOME", ".claude") / "skills",
        "grok": resolve_home("GROK_HOME", ".grok") / "skills",
        "pi": resolve_home("PI_HOME", ".pi") / "agent/skills",
        "omp": home() / ".omp/agent/skills",
    }


def keep_list_paths() -> list[Path]:
    """New path first; fall back to older locations."""
    return [
        config_dir() / "keep-skills",
        xdg_config() / "skills/keep-skills",
        xdg_config() / "agent-sync/keep-skills",
    ]


def read_keep_list() -> set[str]:
    for path in keep_list_paths():
        if not path.is_file():
            continue
        lines = (line.strip() for line in path.read_text(errors="replace").splitlines())
        return {line for line in lines if line and not line.startswith("#")}
    return set()


def die(msg: str, code: int = 1) -> None:
    print(f"{PROG}: {msg}", file=sys.stderr)
    raise SystemExit(code)


def log(msg: str) -> None:
    print(f"{PROG}: {msg}")


def warn(msg: str) -> None:
    print(f"{PROG}: warning: {msg}", file=sys.stderr)


def config_example(path_hint: str) -> str:
    return (
        f"Create {config_dir() / 'config.toml'} with:\n"
        f'  entrypoint = "{path_hint}"\n'
        "Or pass --entrypoint PATH / set SKILL_CLI_ENTRYPOINT."
    )


def resolve_entrypoint(cli_value: str | None) -> Path:
    if cli_value:
        return Path(cli_value).expanduser().resolve()
    env = os.environ.get("SKILL_CLI_ENTRYPOINT")
    if env:
        return Path(env).expanduser().resolve()
    cfg = config_dir() / "config.toml"
    if cfg.is_file():
        try:
            data = tomllib.loads(cfg.read_text())
        except tomllib.TOMLDecodeError as exc:
            die(f"bad config {cfg}: {exc}")
        ep = data.get("entrypoint")
        if isinstance(ep, str) and ep.strip():
            return Path(ep).expanduser().resolve()
        die(f"{cfg} has no entrypoint string\n{config_example('~/code/dotfiles/agents')}")
    die(
        "no entrypoint configured\n"
        + config_example("~/code/dotfiles/agents")
    )


def configure(entrypoint: Path) -> None:
    global AGENTS_DIR, REPO_ROOT, SKILLS_DIR, REGISTRY
    if not entrypoint.is_dir():
        die(f"entrypoint is not a directory: {entrypoint}")
    AGENTS_DIR = entrypoint
    REPO_ROOT = entrypoint.parent
    SKILLS_DIR = entrypoint / "skills"
    REGISTRY = entrypoint / "skills.yaml"


# --- SKILL.md / registry --------------------------------------------------

def read_frontmatter(path: Path) -> dict[str, str]:
    text = path.read_text(errors="replace")
    match = re.match(r"---\r?\n(.*?)\r?\n---", text, re.S)
    fields: dict[str, str] = {}
    for line in (match.group(1).splitlines() if match else []):
        key, sep, value = line.partition(":")
        if sep and key.strip() in ("name", "description"):
            value = value.strip()
            if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
                value = value[1:-1]
            fields[key.strip()] = value
    return fields


def hash_file(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()[:8]


def quote(value: object) -> str:
    return json.dumps(value, ensure_ascii=False)


def list_repo_skills() -> list[Path]:
    if not SKILLS_DIR.is_dir():
        return []
    return sorted(p for p in SKILLS_DIR.iterdir() if p.is_dir() and not p.name.startswith("."))


def find_problems(skill_dir: Path) -> list[str]:
    path = skill_dir / "SKILL.md"
    if not path.is_file():
        return ["no SKILL.md"]
    meta, found = read_frontmatter(path), []
    name, desc = meta.get("name", ""), meta.get("description", "")
    if name != skill_dir.name:
        found.append(f"frontmatter name {name!r} != folder name")
    if not NAME_RE.match(skill_dir.name) or len(skill_dir.name) > 64:
        found.append("folder name must be lowercase-hyphen, <= 64 chars")
    if not desc or len(desc) > 1024:
        found.append("description missing or > 1024 chars")
    elif desc[0] in ">|":
        found.append("description must be one line")
    return found


def read_registry() -> dict[str, dict]:
    """Parse the list-of-mappings YAML that render_registry writes.

    Supports one level of nesting for `source:` (url / pin / path).
    """
    entries: dict[str, dict] = {}
    current: dict | None = None
    nest: dict | None = None
    if not REGISTRY.is_file():
        return entries
    for line in REGISTRY.read_text().splitlines():
        nest_match = re.match(r"^    (\w+):(?: (.*))?$", line)
        if nest_match and nest is not None:
            key, raw = nest_match.group(1), nest_match.group(2)
            if raw is None:
                continue
            try:
                value = json.loads(raw)
            except ValueError:
                value = raw.strip()
            nest[key] = value
            continue
        match = re.match(r"^(- |  )(\w+):(?: (.*))?$", line)
        if not match:
            continue
        lead, key, raw = match.groups()
        nest = None
        if raw is None:
            if current is None:
                continue
            nest = {}
            current[key] = nest
            continue
        try:
            value = json.loads(raw)
        except ValueError:
            value = raw.strip()
        if lead == "- " and key == "name":
            current = entries.setdefault(value, {})
        elif current is not None:
            current[key] = value
    return entries


def source_info(fields: dict) -> dict | None:
    """Return the external source mapping, or None for a local skill."""
    src = fields.get("source")
    if isinstance(src, dict) and src.get("url"):
        return src
    return None


def is_external(fields: dict) -> bool:
    return source_info(fields) is not None


def render_source_lines(source: dict) -> list[str]:
    lines = [
        "  source:",
        f"    url: {quote(source.get('url') or '')}",
        f"    pin: {quote(source.get('pin') or '')}",
    ]
    path = source.get("path") or ""
    if path:
        lines.append(f"    path: {quote(path)}")
    return lines


def render_registry(old: dict[str, dict] | None = None) -> str:
    old = old if old is not None else read_registry()
    out = [
        "# Shared agent skills. Generated by `skill-cli registry`.",
        "# Edit status, purpose, source, agents.",
        "# name and description come from SKILL.md (local) or cache (external).",
        "# External skills use source.url + source.pin (+ optional source.path);",
        "# they are NOT stored under agents/skills/ — sync fetches them into cache.",
    ]
    emitted: set[str] = set()
    for skill in list_repo_skills():
        if not (skill / "SKILL.md").is_file():
            continue
        name = skill.name
        human = old.get(name, {})
        desc = read_frontmatter(skill / "SKILL.md").get("description", "")
        out += [
            f"- name: {quote(name)}",
            f"  description: {quote(desc)}",
            f"  status: {quote(human.get('status') or 'active')}",
            f"  purpose: {quote(human.get('purpose') or '')}",
        ]
        # Local folders are local skills; drop any stale source block.
        agents = human.get("agents")
        if agents:
            out.append(f"  agents: {quote(agents)}")
        emitted.add(name)

    for name, fields in sorted(old.items()):
        if name in emitted:
            continue
        src = source_info(fields)
        if not src:
            continue
        desc = fields.get("description") or ""
        cached = peek_external_skill_dir(name, src)
        if cached is not None:
            desc = read_frontmatter(cached / "SKILL.md").get("description", desc)
        out += [
            f"- name: {quote(name)}",
            f"  description: {quote(desc)}",
            f"  status: {quote(fields.get('status') or 'experimental')}",
            f"  purpose: {quote(fields.get('purpose') or '')}",
        ]
        out += render_source_lines(src)
        agents = fields.get("agents")
        if agents:
            out.append(f"  agents: {quote(agents)}")
        emitted.add(name)
    return "\n".join(out) + "\n"


def find_registry_errors() -> list[str]:
    errors: list[str] = []
    registry = read_registry()
    repo = {s.name: s for s in list_repo_skills()}
    for name, skill in repo.items():
        errors += [f"{name}: {p}" for p in find_problems(skill)]
        if is_external(registry.get(name, {})):
            errors.append(
                f"{name}: external skill must not have {SKILLS_DIR.name}/{name}/; "
                "remove the folder (sync fetches into cache)"
            )
    for name, fields in registry.items():
        if fields.get("status") not in STATUSES:
            errors.append(f"{name}: status must be one of {', '.join(STATUSES)}")
        src = fields.get("source")
        if src is None or src == "":
            if name not in repo:
                errors.append(f"{name}: listed in registry but no {SKILLS_DIR.name}/{name}/")
            continue
        if not isinstance(src, dict):
            errors.append(f"{name}: source must be a mapping with url and pin")
            continue
        if not src.get("url"):
            errors.append(f"{name}: source.url missing")
        pin = src.get("pin") or ""
        if not pin:
            errors.append(f"{name}: source.pin missing")
        elif not SHA_RE.match(str(pin)):
            warn(f"{name}: source.pin is not a 40-char commit SHA")
        if name in repo:
            pass  # already reported above
        elif name not in repo and not is_external(fields):
            errors.append(f"{name}: listed in registry but no {SKILLS_DIR.name}/{name}/")
    for name, skill in repo.items():
        if name not in registry and (skill / "SKILL.md").is_file():
            errors.append(f"{name}: missing from {REGISTRY.name}; run {PROG} registry")
    if not REGISTRY.is_file() or REGISTRY.read_text() != render_registry(registry):
        errors.append(f"{REGISTRY.name} is out of date; run {PROG} registry")
    return errors


def write_registry(old: dict[str, dict] | None = None) -> None:
    REGISTRY.write_text(render_registry(old))


def cmd_registry(args: argparse.Namespace) -> int:
    if not args.check:
        write_registry()
        log(f"wrote {REGISTRY}")
    errors = find_registry_errors()
    for error in errors:
        print(f"{PROG}: {error}", file=sys.stderr)
    return 1 if errors else 0


def cmd_check(_args: argparse.Namespace) -> int:
    return cmd_registry(argparse.Namespace(check=True))


# --- external fetch (git + XDG cache) ------------------------------------

def parse_git_url(url: str) -> tuple[str, str]:
    """Return (host, owner/repo) for cache layout."""
    raw = url.strip().rstrip("/")
    if raw.endswith(".git"):
        raw = raw[:-4]
    if raw.startswith("git@"):
        _, rest = raw.split("@", 1)
        host, _, path = rest.partition(":")
        if not host or not path:
            die(f"unrecognized git url: {url}")
        return host, path
    if raw.startswith("file:"):
        path = raw[5:]
        if path.startswith("//"):
            path = path[2:]
        return "file", path.lstrip("/") or "repo"
    match = re.match(r"^https?://([^/]+)/(.+)$", raw)
    if match:
        return match.group(1), match.group(2)
    die(f"unrecognized git url: {url}")


def cache_dir_for(url: str, pin: str) -> Path:
    host, repo = parse_git_url(url)
    parts = Path(repo)
    # ~/.cache/skill-cli/<host>/<owner>/.../<name>@<pin>
    return xdg_cache() / "skill-cli" / host / parts.parent / f"{parts.name}@{pin}"


def _git(cmd: list[str], cwd: Path | None, env: dict) -> subprocess.CompletedProcess:
    return subprocess.run(
        cmd, cwd=cwd, env=env, capture_output=True, text=True, check=False,
    )


def ensure_fetched(url: str, pin: str) -> Path:
    """Fetch url at pin into the XDG cache. Reuses cache when pin matches."""
    if shutil.which("git") is None:
        die("git not found; required for external skills")
    dest = cache_dir_for(url, pin)
    marker = dest / ".skill-cli-pin"
    if marker.is_file() and marker.read_text().strip() == pin:
        return dest

    env = {**os.environ, "GIT_TERMINAL_PROMPT": "0", "GIT_CONFIG_NOSYSTEM": "1"}
    if dest.exists():
        shutil.rmtree(dest)
    dest.mkdir(parents=True, exist_ok=True)

    log(f"fetching {url}@{pin}")
    init = _git(["git", "init"], dest, env)
    if init.returncode != 0:
        die(f"git init failed in {dest}: {init.stderr.strip()}")
    _git(["git", "remote", "add", "origin", url], dest, env)
    fetched = _git(["git", "fetch", "--depth", "1", "origin", pin], dest, env)
    if fetched.returncode != 0:
        # Some hosts refuse sha shallow fetch; fall back to full clone.
        shutil.rmtree(dest)
        clone = _git(["git", "clone", url, str(dest)], None, env)
        if clone.returncode != 0:
            die(
                f"could not fetch {url}@{pin}: {fetched.stderr.strip() or clone.stderr.strip()}"
            )
        checked = _git(["git", "checkout", "--detach", pin], dest, env)
        if checked.returncode != 0:
            die(f"could not checkout {pin} in {url}: {checked.stderr.strip()}")
    else:
        checked = _git(["git", "checkout", "--detach", "FETCH_HEAD"], dest, env)
        if checked.returncode != 0:
            die(f"could not checkout FETCH_HEAD for {url}@{pin}: {checked.stderr.strip()}")

    if SHA_RE.match(pin):
        head = _git(["git", "rev-parse", "HEAD"], dest, env)
        got = (head.stdout or "").strip()
        if head.returncode != 0 or got != pin:
            die(f"pin mismatch for {url}: wanted {pin}, got {got or 'unknown'}")

    marker.write_text(pin + "\n")
    return dest


def resolve_skill_subdir(root: Path, name: str, subpath: str) -> Path:
    candidates: list[Path] = []
    if subpath:
        candidates.append(root / subpath)
    else:
        candidates.append(root / name)
        candidates.append(root)
    for candidate in candidates:
        if (candidate / "SKILL.md").is_file():
            return candidate
    where = f" path={subpath}" if subpath else ""
    die(f"{name}: no SKILL.md under {root}{where}")


def peek_external_skill_dir(name: str, source: dict) -> Path | None:
    """Return cached skill dir if already fetched; else None (no network)."""
    url = source.get("url") or ""
    pin = source.get("pin") or ""
    if not url or not pin:
        return None
    dest = cache_dir_for(url, pin)
    marker = dest / ".skill-cli-pin"
    if not marker.is_file() or marker.read_text().strip() != pin:
        return None
    subpath = source.get("path") or ""
    try:
        return resolve_skill_subdir(dest, name, subpath)
    except SystemExit:
        return None


def external_skill_dir(name: str, source: dict, *, fetch: bool) -> Path:
    """Resolve the directory that contains SKILL.md for an external skill."""
    if not source.get("url"):
        die(f"{name}: source.url missing")
    if not source.get("pin"):
        die(f"{name}: source.pin missing")
    if fetch:
        root = ensure_fetched(source["url"], source["pin"])
    else:
        root = cache_dir_for(source["url"], source["pin"])
        marker = root / ".skill-cli-pin"
        if not marker.is_file() or marker.read_text().strip() != source["pin"]:
            die(f"{name}: not in cache; run sync (or add) to fetch {source['url']}@{source['pin']}")
    return resolve_skill_subdir(root, name, source.get("path") or "")


# --- add / remove (repo only) ---------------------------------------------

SKILL_TEMPLATE = """\
---
name: {name}
description: TODO: one-line description of when to use this skill.
---

# {name}

Describe what this skill does.
"""


def cmd_add(args: argparse.Namespace) -> int:
    registry = read_registry()
    name = args.name
    if not NAME_RE.match(name) or len(name) > 64:
        die(f"skill name must be lowercase-hyphen, <= 64 chars: {name!r}")

    if args.source:
        if not args.pin:
            die("--pin is required with --source")
        source = {"url": args.source, "pin": args.pin}
        if args.path:
            source["path"] = args.path
        content = external_skill_dir(name, source, fetch=True)
        desc = read_frontmatter(content / "SKILL.md").get("description", "")
        skill_dir = SKILLS_DIR / name
        if skill_dir.exists():
            die(
                f"{name} has a local folder at {skill_dir}; "
                "remove it first — external skills are registry-only"
            )
        entry = registry.get(name, {})
        entry["status"] = entry.get("status") or "experimental"
        entry["purpose"] = entry.get("purpose") or f"External: {args.source}."
        entry["description"] = desc
        entry["source"] = source
        registry[name] = entry
        write_registry(registry)
        log(f"registered external {name} from {args.source}@{args.pin}")
        return 0

    if args.pin or args.path:
        die("--pin/--path require --source")

    SKILLS_DIR.mkdir(parents=True, exist_ok=True)
    skill_dir = SKILLS_DIR / name
    skill_md = skill_dir / "SKILL.md"
    created = False
    if not skill_md.is_file():
        skill_dir.mkdir(parents=True, exist_ok=True)
        skill_md.write_text(SKILL_TEMPLATE.format(name=name))
        log(f"created {skill_md}")
        created = True
    else:
        log(f"already exists {skill_md}")
    entry = registry.get(name, {})
    entry["status"] = entry.get("status") or "active"
    entry["purpose"] = entry.get("purpose") or ""
    if created:
        entry.pop("source", None)
    registry[name] = entry
    write_registry(registry)
    log(f"registered {name}")
    return 0


def cmd_remove(args: argparse.Namespace) -> int:
    """Delete the skill folder (if local) and registry entry. Never touches local agent dirs."""
    registry = read_registry()
    name = args.name
    skill_dir = SKILLS_DIR / name
    if name not in registry and not skill_dir.exists():
        die(f"{name!r} is not in the registry and has no folder", code=2)
    if skill_dir.exists():
        shutil.rmtree(skill_dir)
        log(f"deleted {skill_dir}")
    if name in registry:
        del registry[name]
        write_registry(registry)
        log(f"removed {name} from {REGISTRY.name}")
    return 0


# --- sync -----------------------------------------------------------------

def has_real_files(directory: Path) -> bool:
    if not directory.is_dir():
        return False
    for path in directory.rglob("*"):
        if path.is_file() and path.name != "README.md":
            return True
    return False


def copy_path(src: Path, dest: Path, dry_run: bool) -> None:
    if not src.exists():
        return
    if dry_run:
        log(f"would copy {src} -> {dest}")
        return
    dest.parent.mkdir(parents=True, exist_ok=True)
    if src.is_dir():
        if dest.exists():
            shutil.rmtree(dest)
        shutil.copytree(src, dest)
    else:
        shutil.copy2(src, dest)


def copy_dir_contents(src: Path, dest: Path, dry_run: bool, skip: str | None = None) -> None:
    if not src.is_dir():
        return
    if dry_run:
        log(f"would sync {src}/ -> {dest}/")
        return
    dest.mkdir(parents=True, exist_ok=True)
    for item in list(src.iterdir()):
        if skip and item.name == skip:
            continue
        target = dest / item.name
        if item.is_dir():
            if target.exists():
                shutil.rmtree(target)
            shutil.copytree(item, target)
        else:
            shutil.copy2(item, target)


def copy_skill_tree(src: Path, dest: Path, dry_run: bool) -> None:
    """Copy one skill folder, skipping evals/."""
    if dry_run:
        log(f"would sync {src}/ -> {dest}/ (without evals/)")
        return
    dest.mkdir(parents=True, exist_ok=True)
    for item in src.iterdir():
        if item.name == "evals":
            continue
        target = dest / item.name
        if item.is_dir():
            if target.exists():
                shutil.rmtree(target)
            shutil.copytree(item, target)
        else:
            shutil.copy2(item, target)


def agents_for(fields: dict) -> tuple[str, ...]:
    raw = fields.get("agents")
    if not raw:
        return SYNCED
    if isinstance(raw, str):
        parts = [p.strip() for p in raw.split(",") if p.strip()]
    elif isinstance(raw, list):
        parts = [str(p) for p in raw]
    else:
        parts = list(SYNCED)
    bad = [p for p in parts if p not in SYNCED]
    if bad:
        die(f"unknown agents {bad}; expected subset of {list(SYNCED)}")
    return tuple(parts) if parts else SYNCED


def prune_skills(
    known: set[str],
    dest: Path,
    label: str,
    removed_dir: Path,
    keep: set[str],
    dry_run: bool,
) -> None:
    if not dest.is_dir():
        return
    for item in sorted(dest.iterdir()):
        if item.name.startswith("."):
            continue
        if not (item.is_symlink() or item.is_dir()):
            continue
        if item.name in known or item.name in keep:
            continue
        if dry_run:
            log(f"would remove stale skill {item}")
            continue
        target = removed_dir / label / item.name
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(str(item), str(target))
        log(f"removed stale skill {item} -> {target}")


def cmd_sync(args: argparse.Namespace) -> int:
    dry_run = args.dry_run
    if not AGENTS_DIR.is_dir():
        die(f"missing {AGENTS_DIR}")
    registry = read_registry()
    repo_skills = [s for s in list_repo_skills() if (s / "SKILL.md").is_file()]
    externals = [(n, f) for n, f in sorted(registry.items()) if source_info(f)]
    if not repo_skills and not externals:
        die(f"no skills in {SKILLS_DIR} or {REGISTRY.name}; refusing to prune")

    agents_home = resolve_home("AGENTS_HOME", ".agents")
    codex_home = resolve_home("CODEX_HOME", ".codex")
    claude_home = resolve_home("CLAUDE_HOME", ".claude")
    grok_home = resolve_home("GROK_HOME", ".grok")
    pi_home = resolve_home("PI_HOME", ".pi")

    log(f"entrypoint: {AGENTS_DIR}")
    log(f"codex:  {codex_home}")
    log(f"agents: {agents_home}")
    log(f"claude: {claude_home}")
    log(f"grok:   {grok_home}")
    log(f"pi:     {pi_home}")

    keep = read_keep_list()
    stamp = time.strftime("%Y%m%d-%H%M%S")
    # Prefer ~/.local/share/skills for continuity with earlier skill-cli / tests.
    removed_dir = xdg_data() / "skills" / f"removed-{stamp}-{os.getpid()}"

    known = {s.name for s in repo_skills}
    known.update(n for n, _ in externals)
    skill_dests = {
        "agents": agents_home / "skills",
        "codex": codex_home / "skills",
        "claude": claude_home / "skills",
        "grok": grok_home / "skills",
    }
    for label, dest in skill_dests.items():
        prune_skills(known, dest, label, removed_dir, keep, dry_run)

    # Local skills (folders under agents/skills/).
    for skill in repo_skills:
        fields = registry.get(skill.name, {})
        for label in agents_for(fields):
            if label not in skill_dests:
                continue
            copy_skill_tree(skill, skill_dests[label] / skill.name, dry_run)

    # External skills (registry-only; fetch into cache, then copy).
    for name, fields in externals:
        src = source_info(fields)
        assert src is not None
        if dry_run:
            cached = peek_external_skill_dir(name, src)
            if cached is None:
                log(
                    f"would fetch {src['url']}@{src['pin']}"
                    + (f" path={src['path']}" if src.get("path") else "")
                    + f" then sync {name}"
                )
            else:
                for label in agents_for(fields):
                    if label in skill_dests:
                        copy_skill_tree(cached, skill_dests[label] / name, dry_run=True)
            continue
        content = external_skill_dir(name, src, fetch=True)
        for label in agents_for(fields):
            if label not in skill_dests:
                continue
            copy_skill_tree(content, skill_dests[label] / name, dry_run=False)

    prompts = AGENTS_DIR / "prompts"
    if has_real_files(prompts):
        copy_dir_contents(prompts, codex_home / "prompts", dry_run)
        copy_dir_contents(prompts, claude_home / "prompts", dry_run)

    copy_dir_contents(AGENTS_DIR / "codex", codex_home, dry_run)
    copy_dir_contents(AGENTS_DIR / "claude/commands", claude_home / "commands", dry_run)
    copy_dir_contents(AGENTS_DIR / "claude/roles", claude_home / "agents", dry_run)
    copy_path(AGENTS_DIR / "claude/CLAUDE.md", claude_home / "CLAUDE.md", dry_run)
    copy_path(AGENTS_DIR / "claude/settings.json", claude_home / "settings.json", dry_run)
    copy_dir_contents(REPO_ROOT / ".pi", pi_home, dry_run)

    log("done")
    return 0


