#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Manage shared agent skills. One CLI for sync, status, registry, and evals.

  skill-cli sync [--dry-run]          copy skills (local + external) to agent dirs
  skill-cli status [--json]           usage, drift, orphans on this machine
  skill-cli check                     lint skills.yaml (for tests/CI)
  skill-cli registry                  regenerate skills.yaml; keep human fields
  skill-cli add NAME                  create agents/skills/NAME + register
  skill-cli add NAME --source URL --pin SHA [--path SUB]
                                  register an external skill (git fetch at sync)
  skill-cli remove NAME               delete folder + registry entry (repo only)
  skill-cli eval NAME [args]          run skills/NAME/evals/run with SKILL_DIR set

Config: ${XDG_CONFIG_HOME:-~/.config}/skill-cli/config.toml
  entrypoint = "/path/to/dotfiles/agents"

Override with --entrypoint or SKILL_CLI_ENTRYPOINT. OS-agnostic (macOS + Linux).
Copies files; never symlinks. Only sync changes local agent dirs (add/update only;
never deletes local skills that are not in the repo).
External skills live in skills.yaml under source.url / source.pin [/ source.path];
fetched into ${XDG_CACHE_HOME:-~/.cache}/skill-cli/ and never vendored into the repo.
"""

from __future__ import annotations

import argparse
import collections
import datetime
import glob
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tomllib
from dataclasses import dataclass
from pathlib import Path

PROG = "skill-cli"
HUMAN_FIELDS = ("status", "purpose", "source", "agents")
SHA_RE = re.compile(r"^[0-9a-f]{40}$")
STATUSES = ("active", "experimental", "deprecated")
NAME_RE = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")
SKILL_PATH = re.compile(r"/([A-Za-z0-9._:~-]+)/SKILL\.md")
DORMANT_DAYS = 60
SYNCED = ("agents", "codex", "claude", "grok")
OBSERVED = ("pi", "omp")


@dataclass(frozen=True)
class Paths:
    agents_dir: Path
    repo_root: Path
    skills_dir: Path
    registry: Path

    @classmethod
    def from_entrypoint(cls, entrypoint: Path) -> Paths:
        if not entrypoint.is_dir():
            die(f"entrypoint is not a directory: {entrypoint}")
        return cls(
            agents_dir=entrypoint,
            repo_root=entrypoint.parent,
            skills_dir=entrypoint / "skills",
            registry=entrypoint / "skills.yaml",
        )


class FetchError(Exception):
    """External skill fetch or resolve failed; sync continues past these."""


# --- paths ----------------------------------------------------------------

def resolve_home_var(var: str, default: str) -> Path:
    return Path(os.environ[var]) if os.environ.get(var) else Path.home() / default


def resolve_xdg_config() -> Path:
    return resolve_home_var("XDG_CONFIG_HOME", ".config")


def resolve_xdg_cache() -> Path:
    return resolve_home_var("XDG_CACHE_HOME", ".cache")


def resolve_config_dir() -> Path:
    return resolve_xdg_config() / "skill-cli"


def list_skill_roots() -> dict[str, Path]:
    return {
        "agents": resolve_home_var("AGENTS_HOME", ".agents") / "skills",
        "codex": resolve_home_var("CODEX_HOME", ".codex") / "skills",
        "claude": resolve_home_var("CLAUDE_HOME", ".claude") / "skills",
        "grok": resolve_home_var("GROK_HOME", ".grok") / "skills",
        "pi": resolve_home_var("PI_HOME", ".pi") / "agent/skills",
        "omp": Path.home() / ".omp/agent/skills",
    }


def die(msg: str, code: int = 1) -> None:
    print(f"{PROG}: {msg}", file=sys.stderr)
    raise SystemExit(code)


def log(msg: str) -> None:
    print(f"{PROG}: {msg}")


def warn(msg: str) -> None:
    print(f"{PROG}: warning: {msg}", file=sys.stderr)


def validate_name(name: str) -> str:
    if not NAME_RE.match(name) or len(name) > 64:
        die(f"skill name must be lowercase-hyphen, <= 64 chars: {name!r}")
    return name


def skill_path_for(paths: Paths, name: str) -> Path:
    """Return skills_dir/name after validating name; die if it escapes skills_dir."""
    validate_name(name)
    root = paths.skills_dir.resolve()
    skill_dir = (paths.skills_dir / name).resolve()
    if skill_dir != root and root not in skill_dir.parents:
        die(f"skill path escapes {paths.skills_dir}: {name!r}")
    return paths.skills_dir / name


def pin_problem(pin: object) -> str | None:
    if not pin:
        return "source.pin missing"
    if not SHA_RE.match(str(pin)):
        return "source.pin must be a 40-char commit SHA"
    return None


def format_config_example(path_hint: str) -> str:
    return (
        f"Create {resolve_config_dir() / 'config.toml'} with:\n"
        f'  entrypoint = "{path_hint}"\n'
        "Or pass --entrypoint PATH / set SKILL_CLI_ENTRYPOINT."
    )


def resolve_entrypoint(cli_value: str | None) -> Path:
    if cli_value:
        return Path(cli_value).expanduser().resolve()
    env = os.environ.get("SKILL_CLI_ENTRYPOINT")
    if env:
        return Path(env).expanduser().resolve()
    cfg = resolve_config_dir() / "config.toml"
    if cfg.is_file():
        try:
            data = tomllib.loads(cfg.read_text())
        except tomllib.TOMLDecodeError as exc:
            die(f"bad config {cfg}: {exc}")
        ep = data.get("entrypoint")
        if isinstance(ep, str) and ep.strip():
            return Path(ep).expanduser().resolve()
        die(f"{cfg} has no entrypoint string\n{format_config_example('~/code/dotfiles/agents')}")
    die(
        "no entrypoint configured\n"
        + format_config_example("~/code/dotfiles/agents")
    )


# --- SKILL.md / registry --------------------------------------------------

def read_frontmatter(path: Path) -> dict[str, str]:
    text = path.read_text(errors="replace")
    match = re.match(r"---\r?\n(.*?)\r?\n---", text, re.S)
    fields: dict[str, str] = {}
    for line in (match.group(1).splitlines() if match else []):
        key, sep, value = line.partition(":")
        if sep and key.strip() in ("name", "description"):
            value = value.strip()
            if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
                value = value[1:-1]
            fields[key.strip()] = value
    return fields


def hash_file(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()[:8]


def format_yaml_value(value: object) -> str:
    return json.dumps(value, ensure_ascii=False)


def list_repo_skills(paths: Paths) -> list[Path]:
    if not paths.skills_dir.is_dir():
        return []
    return sorted(
        p for p in paths.skills_dir.iterdir() if p.is_dir() and not p.name.startswith(".")
    )


def find_problems(skill_dir: Path) -> list[str]:
    path = skill_dir / "SKILL.md"
    if not path.is_file():
        return ["no SKILL.md"]
    meta, found = read_frontmatter(path), []
    name, desc = meta.get("name", ""), meta.get("description", "")
    if name != skill_dir.name:
        found.append(f"frontmatter name {name!r} != folder name")
    if not NAME_RE.match(skill_dir.name) or len(skill_dir.name) > 64:
        found.append("folder name must be lowercase-hyphen, <= 64 chars")
    if not desc or len(desc) > 1024:
        found.append("description missing or > 1024 chars")
    elif desc[0] in ">|":
        found.append("description must be one line")
    return found


def read_registry(paths: Paths) -> dict[str, dict]:
    """Parse the list-of-mappings YAML that render_registry writes.

    Supports one level of nesting for `source:` (url / pin / path).
    """
    entries: dict[str, dict] = {}
    current: dict | None = None
    nest: dict | None = None
    if not paths.registry.is_file():
        return entries
    for line in paths.registry.read_text().splitlines():
        nest_match = re.match(r"^    (\w+):(?: (.*))?$", line)
        if nest_match and nest is not None:
            key, raw = nest_match.group(1), nest_match.group(2)
            if raw is None:
                continue
            try:
                value = json.loads(raw)
            except ValueError:
                value = raw.strip()
            nest[key] = value
            continue
        match = re.match(r"^(- |  )(\w+):(?: (.*))?$", line)
        if not match:
            continue
        lead, key, raw = match.groups()
        nest = None
        if raw is None:
            if current is None:
                continue
            nest = {}
            current[key] = nest
            continue
        try:
            value = json.loads(raw)
        except ValueError:
            value = raw.strip()
        if lead == "- " and key == "name":
            current = entries.setdefault(value, {})
        elif current is not None:
            current[key] = value
    return entries


def read_source(fields: dict) -> dict | None:
    """Return the external source mapping, or None for a local skill."""
    src = fields.get("source")
    if isinstance(src, dict) and src.get("url"):
        return src
    return None


def render_source_lines(source: dict) -> list[str]:
    lines = [
        "  source:",
        f"    url: {format_yaml_value(source.get('url') or '')}",
        f"    pin: {format_yaml_value(source.get('pin') or '')}",
    ]
    path = source.get("path") or ""
    if path:
        lines.append(f"    path: {format_yaml_value(path)}")
    return lines


def render_registry(paths: Paths, old: dict[str, dict] | None = None) -> str:
    old = old if old is not None else read_registry(paths)
    out = [
        "# Shared agent skills. Generated by `skill-cli registry`.",
        "# Edit status, purpose, source, agents.",
        "# name and description come from SKILL.md (local) or cache (external).",
        "# External skills use source.url + source.pin (+ optional source.path);",
        "# they are NOT stored under agents/skills/ — sync fetches them into cache.",
    ]
    emitted: set[str] = set()
    for skill in list_repo_skills(paths):
        if not (skill / "SKILL.md").is_file():
            continue
        name = skill.name
        human = old.get(name, {})
        desc = read_frontmatter(skill / "SKILL.md").get("description", "")
        out += [
            f"- name: {format_yaml_value(name)}",
            f"  description: {format_yaml_value(desc)}",
            f"  status: {format_yaml_value(human.get('status') or 'active')}",
            f"  purpose: {format_yaml_value(human.get('purpose') or '')}",
        ]
        agents = human.get("agents")
        if agents:
            out.append(f"  agents: {format_yaml_value(agents)}")
        emitted.add(name)

    for name, fields in sorted(old.items()):
        if name in emitted:
            continue
        src = fields.get("source")
        if not isinstance(src, dict):
            continue
        desc = fields.get("description") or ""
        cached = peek_external_skill_dir(name, src)
        if cached is not None:
            desc = read_frontmatter(cached / "SKILL.md").get("description", desc)
        out += [
            f"- name: {format_yaml_value(name)}",
            f"  description: {format_yaml_value(desc)}",
            f"  status: {format_yaml_value(fields.get('status') or 'experimental')}",
            f"  purpose: {format_yaml_value(fields.get('purpose') or '')}",
        ]
        out += render_source_lines(src)
        agents = fields.get("agents")
        if agents:
            out.append(f"  agents: {format_yaml_value(agents)}")
        emitted.add(name)
    return "\n".join(out) + "\n"


def find_registry_errors(paths: Paths) -> list[str]:
    errors: list[str] = []
    registry = read_registry(paths)
    repo = {s.name: s for s in list_repo_skills(paths)}
    for name, skill in repo.items():
        errors += [f"{name}: {p}" for p in find_problems(skill)]
        if read_source(registry.get(name, {})):
            errors.append(
                f"{name}: external skill must not have {paths.skills_dir.name}/{name}/; "
                "remove the folder (sync fetches into cache)"
            )
    for name, fields in registry.items():
        if fields.get("status") not in STATUSES:
            errors.append(f"{name}: status must be one of {', '.join(STATUSES)}")
        src = fields.get("source")
        if src is None or src == "":
            if name not in repo:
                errors.append(
                    f"{name}: listed in registry but no {paths.skills_dir.name}/{name}/"
                )
            continue
        if not isinstance(src, dict):
            errors.append(f"{name}: source must be a mapping with url and pin")
            continue
        if not src.get("url"):
            errors.append(f"{name}: source.url missing")
        else:
            try:
                parse_git_url(str(src["url"]))
            except FetchError as exc:
                errors.append(f"{name}: {exc}")
        problem = pin_problem(src.get("pin"))
        if problem:
            errors.append(f"{name}: {problem}")
    for name, skill in repo.items():
        if name not in registry and (skill / "SKILL.md").is_file():
            errors.append(f"{name}: missing from {paths.registry.name}; run {PROG} registry")
    stale = (
        not paths.registry.is_file()
        or paths.registry.read_text() != render_registry(paths, registry)
    )
    if stale:
        # Incomplete source blocks make render rewrite url/pin lines; report those
        # alone so check does not also say "out of date" and push a destructive registry.
        source_issue = any(
            "source.url" in e or "source.pin" in e or "source must be" in e
            or "unrecognized git url" in e
            for e in errors
        )
        if not source_issue:
            errors.append(f"{paths.registry.name} is out of date; run {PROG} registry")
    return errors


def write_registry(paths: Paths, old: dict[str, dict] | None = None) -> None:
    paths.registry.write_text(render_registry(paths, old))


def cmd_registry(paths: Paths, args: argparse.Namespace) -> int:
    if not args.check:
        write_registry(paths)
        log(f"wrote {paths.registry}")
    errors = find_registry_errors(paths)
    for error in errors:
        print(f"{PROG}: {error}", file=sys.stderr)
    return 1 if errors else 0


def cmd_check(paths: Paths, _args: argparse.Namespace) -> int:
    return cmd_registry(paths, argparse.Namespace(check=True))


# --- external fetch (git + XDG cache) ------------------------------------

def parse_git_url(url: str) -> tuple[str, str]:
    """Return (host, owner/repo) for cache layout. Raises FetchError if unrecognized."""
    raw = url.strip().rstrip("/")
    if raw.endswith(".git"):
        raw = raw[:-4]
    if raw.startswith("git@"):
        _, rest = raw.split("@", 1)
        host, _, path = rest.partition(":")
        if not host or not path:
            raise FetchError(f"unrecognized git url: {url}")
        return host, path
    if raw.startswith("file:"):
        path = raw[5:]
        if path.startswith("//"):
            path = path[2:]
        return "file", path.lstrip("/") or "repo"
    match = re.match(r"^(?:https?|ssh)://(?:[^@/]+@)?([^/]+)/(.+)$", raw)
    if match:
        return match.group(1), match.group(2)
    raise FetchError(f"unrecognized git url: {url}")


def resolve_cache_dir(url: str, pin: str) -> Path:
    host, repo = parse_git_url(url)
    parts = Path(repo)
    return resolve_xdg_cache() / "skill-cli" / host / parts.parent / f"{parts.name}@{pin}"


def ensure_fetched(url: str, pin: str) -> Path:
    """Fetch url at pin into the XDG cache. Reuses cache when pin matches."""
    if shutil.which("git") is None:
        raise FetchError("git not found; required for external skills")
    dest = resolve_cache_dir(url, pin)
    marker = dest / ".skill-cli-pin"
    if marker.is_file() and marker.read_text().strip() == pin:
        return dest

    env = {**os.environ, "GIT_TERMINAL_PROMPT": "0", "GIT_CONFIG_NOSYSTEM": "1"}
    if dest.exists():
        shutil.rmtree(dest)
    dest.mkdir(parents=True, exist_ok=True)

    log(f"fetching {url}@{pin}")

    def run(cmd: list[str], cwd: Path | None = None) -> subprocess.CompletedProcess:
        return subprocess.run(cmd, cwd=cwd, env=env, capture_output=True, text=True, check=False)

    init = run(["git", "init"], dest)
    if init.returncode != 0:
        raise FetchError(f"git init failed in {dest}: {init.stderr.strip()}")
    run(["git", "remote", "add", "origin", url], dest)
    fetched = run(["git", "fetch", "--depth", "1", "origin", pin], dest)
    if fetched.returncode != 0:
        shutil.rmtree(dest)
        clone = run(["git", "clone", url, str(dest)])
        if clone.returncode != 0:
            raise FetchError(
                f"could not fetch {url}@{pin}: "
                f"{fetched.stderr.strip() or clone.stderr.strip()}"
            )
        checked = run(["git", "checkout", "--detach", pin], dest)
        if checked.returncode != 0:
            raise FetchError(f"could not checkout {pin} in {url}: {checked.stderr.strip()}")
    else:
        checked = run(["git", "checkout", "--detach", "FETCH_HEAD"], dest)
        if checked.returncode != 0:
            raise FetchError(
                f"could not checkout FETCH_HEAD for {url}@{pin}: {checked.stderr.strip()}"
            )

    head = run(["git", "rev-parse", "HEAD"], dest)
    got = (head.stdout or "").strip()
    if head.returncode != 0 or got != pin:
        raise FetchError(f"pin mismatch for {url}: wanted {pin}, got {got or 'unknown'}")

    marker.write_text(pin + "\n")
    return dest


def resolve_skill_subdir(root: Path, name: str, subpath: str) -> Path | None:
    candidates: list[Path] = []
    if subpath:
        candidates.append(root / subpath)
    else:
        candidates.append(root / name)
        candidates.append(root)
    for candidate in candidates:
        if (candidate / "SKILL.md").is_file():
            return candidate
    return None


def peek_external_skill_dir(name: str, source: dict) -> Path | None:
    """Return cached skill dir if already fetched; else None (no network)."""
    url = source.get("url") or ""
    pin = source.get("pin") or ""
    if not url or not pin:
        return None
    try:
        dest = resolve_cache_dir(url, pin)
    except FetchError:
        return None
    marker = dest / ".skill-cli-pin"
    if not marker.is_file() or marker.read_text().strip() != pin:
        return None
    return resolve_skill_subdir(dest, name, source.get("path") or "")


def resolve_external_skill_dir(name: str, source: dict) -> Path:
    """Fetch and resolve the directory that contains SKILL.md for an external skill."""
    if not source.get("url"):
        raise FetchError(f"{name}: source.url missing")
    problem = pin_problem(source.get("pin"))
    if problem:
        raise FetchError(f"{name}: {problem}")
    root = ensure_fetched(source["url"], source["pin"])
    found = resolve_skill_subdir(root, name, source.get("path") or "")
    if found is None:
        where = f" path={source.get('path')}" if source.get("path") else ""
        raise FetchError(f"{name}: no SKILL.md under {root}{where}")
    return found


# --- add / remove (repo only) ---------------------------------------------

SKILL_TEMPLATE = """\
---
name: {name}
description: TODO: one-line description of when to use this skill.
---

# {name}

Describe what this skill does.
"""


def cmd_add(paths: Paths, args: argparse.Namespace) -> int:
    registry = read_registry(paths)
    name = validate_name(args.name)

    if args.source:
        if not args.pin:
            die("--pin is required with --source")
        problem = pin_problem(args.pin)
        if problem:
            die(f"--pin must be a 40-char commit SHA" if "SHA" in problem else f"--pin: {problem}")
        skill_dir = skill_path_for(paths, name)
        if skill_dir.exists():
            die(
                f"{name} has a local folder at {skill_dir}; "
                "remove it first — external skills are registry-only"
            )
        source = {"url": args.source, "pin": args.pin}
        if args.path:
            source["path"] = args.path
        try:
            content = resolve_external_skill_dir(name, source)
        except FetchError as exc:
            die(str(exc))
        desc = read_frontmatter(content / "SKILL.md").get("description", "")
        entry = registry.get(name, {})
        entry["status"] = entry.get("status") or "experimental"
        entry["purpose"] = entry.get("purpose") or f"External: {args.source}."
        entry["description"] = desc
        entry["source"] = source
        registry[name] = entry
        write_registry(paths, registry)
        log(f"registered external {name} from {args.source}@{args.pin}")
        return 0

    if args.pin or args.path:
        die("--pin/--path require --source")

    paths.skills_dir.mkdir(parents=True, exist_ok=True)
    skill_dir = skill_path_for(paths, name)
    skill_md = skill_dir / "SKILL.md"
    created = False
    if not skill_md.is_file():
        skill_dir.mkdir(parents=True, exist_ok=True)
        skill_md.write_text(SKILL_TEMPLATE.format(name=name))
        log(f"created {skill_md}")
        created = True
    else:
        log(f"already exists {skill_md}")
    entry = registry.get(name, {})
    entry["status"] = entry.get("status") or "active"
    entry["purpose"] = entry.get("purpose") or ""
    if created:
        entry.pop("source", None)
    registry[name] = entry
    write_registry(paths, registry)
    log(f"registered {name}")
    return 0


def cmd_remove(paths: Paths, args: argparse.Namespace) -> int:
    """Delete the skill folder (if local) and registry entry. Never touches local agent dirs."""
    registry = read_registry(paths)
    name = validate_name(args.name)
    skill_dir = skill_path_for(paths, name)
    if name not in registry and not skill_dir.exists():
        die(f"{name!r} is not in the registry and has no folder", code=2)
    if skill_dir.exists():
        shutil.rmtree(skill_dir)
        log(f"deleted {skill_dir}")
    if name in registry:
        del registry[name]
        write_registry(paths, registry)
        log(f"removed {name} from {paths.registry.name}")
    return 0


# --- sync -----------------------------------------------------------------

def has_real_files(directory: Path) -> bool:
    if not directory.is_dir():
        return False
    for path in directory.rglob("*"):
        if path.is_file() and path.name != "README.md":
            return True
    return False


def copy_path(src: Path, dest: Path, dry_run: bool) -> None:
    if not src.exists():
        return
    if dry_run:
        log(f"would copy {src} -> {dest}")
        return
    dest.parent.mkdir(parents=True, exist_ok=True)
    if src.is_dir():
        shutil.copytree(src, dest, dirs_exist_ok=True)
    else:
        shutil.copy2(src, dest)


def copy_dir_contents(src: Path, dest: Path, dry_run: bool, skip: str | None = None) -> None:
    """Merge src into dest. Destination-only files and dirs are kept."""
    if not src.is_dir():
        return
    if dry_run:
        log(f"would sync {src}/ -> {dest}/")
        return
    dest.mkdir(parents=True, exist_ok=True)
    for item in list(src.iterdir()):
        if skip and item.name == skip:
            continue
        target = dest / item.name
        if item.is_dir():
            shutil.copytree(item, target, dirs_exist_ok=True)
        else:
            shutil.copy2(item, target)


def resolve_agents(fields: dict) -> tuple[str, ...]:
    raw = fields.get("agents")
    if not raw:
        return SYNCED
    if not isinstance(raw, list):
        die(f"agents must be a YAML list, got {type(raw).__name__}: {raw!r}")
    parts = [str(p) for p in raw]
    bad = [p for p in parts if p not in SYNCED]
    if bad:
        die(f"unknown agents {bad}; expected subset of {list(SYNCED)}")
    return tuple(parts)


def cmd_sync(paths: Paths, args: argparse.Namespace) -> int:
    dry_run = args.dry_run
    if not paths.agents_dir.is_dir():
        die(f"missing {paths.agents_dir}")
    registry = read_registry(paths)
    repo_skills = [s for s in list_repo_skills(paths) if (s / "SKILL.md").is_file()]
    externals = [(n, f) for n, f in sorted(registry.items()) if read_source(f)]
    if not repo_skills and not externals:
        die(f"no skills in {paths.skills_dir} or {paths.registry.name}")

    agents_home = resolve_home_var("AGENTS_HOME", ".agents")
    codex_home = resolve_home_var("CODEX_HOME", ".codex")
    claude_home = resolve_home_var("CLAUDE_HOME", ".claude")
    grok_home = resolve_home_var("GROK_HOME", ".grok")
    pi_home = resolve_home_var("PI_HOME", ".pi")

    log(f"entrypoint: {paths.agents_dir}")
    log(f"codex:  {codex_home}")
    log(f"agents: {agents_home}")
    log(f"claude: {claude_home}")
    log(f"grok:   {grok_home}")
    log(f"pi:     {pi_home}")

    skill_dests = {label: list_skill_roots()[label] for label in SYNCED}

    for skill in repo_skills:
        fields = registry.get(skill.name, {})
        for label in resolve_agents(fields):
            copy_dir_contents(skill, skill_dests[label] / skill.name, dry_run, skip="evals")

    failed_externals: list[str] = []
    for name, fields in externals:
        src = read_source(fields)
        assert src is not None
        try:
            if dry_run:
                content = peek_external_skill_dir(name, src)
                if content is None:
                    log(
                        f"would fetch {src['url']}@{src['pin']}"
                        + (f" path={src['path']}" if src.get("path") else "")
                        + f" then sync {name}"
                    )
                    continue
            else:
                content = resolve_external_skill_dir(name, src)
        except FetchError as exc:
            warn(str(exc))
            failed_externals.append(name)
            continue
        for label in resolve_agents(fields):
            copy_dir_contents(content, skill_dests[label] / name, dry_run, skip="evals")

    prompts = paths.agents_dir / "prompts"
    if has_real_files(prompts):
        copy_dir_contents(prompts, codex_home / "prompts", dry_run)
        copy_dir_contents(prompts, claude_home / "prompts", dry_run)

    copy_dir_contents(paths.agents_dir / "codex", codex_home, dry_run)
    copy_dir_contents(paths.agents_dir / "claude/commands", claude_home / "commands", dry_run)
    copy_dir_contents(paths.agents_dir / "claude/roles", claude_home / "agents", dry_run)
    copy_path(paths.agents_dir / "claude/CLAUDE.md", claude_home / "CLAUDE.md", dry_run)
    copy_path(paths.agents_dir / "claude/settings.json", claude_home / "settings.json", dry_run)
    copy_dir_contents(paths.repo_root / ".pi", pi_home, dry_run)

    if failed_externals:
        log(f"done with errors: failed externals: {', '.join(failed_externals)}")
        return 1
    log("done")
    return 0


