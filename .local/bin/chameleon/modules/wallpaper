#!/usr/bin/env sh

set -u

if [ -z "${CHAMELEON_ROOT:-}" ]; then
  MODULE_DIR="$(CDPATH= cd "$(dirname "$0")" && pwd)"
  CHAMELEON_ROOT="$(CDPATH= cd "$MODULE_DIR/.." && pwd)"
fi
. "$CHAMELEON_ROOT/lib/common.sh"

apply_wallpaper_linux() {
  wallpaper_path="$1"
  wallpaper_uri="file://$wallpaper_path"
  escaped_uri="$(printf '%s' "$wallpaper_uri" | sed 's/\\/\\\\/g; s/"/\\"/g')" || return 1
  plasma_script="
const ds = desktops();
for (const desktop of ds) {
  desktop.wallpaperPlugin = 'org.kde.image';
  desktop.currentConfigGroup = ['Wallpaper', 'org.kde.image', 'General'];
  desktop.writeConfig('Image', \"$escaped_uri\");
}
"

  command -v qdbus6 >/dev/null 2>&1 || {
    fail_module "wallpaper: qdbus6 not found"
    return $?
  }
  command -v timeout >/dev/null 2>&1 || {
    fail_module "wallpaper: timeout not found (required for KDE Plasma calls)"
    return $?
  }

  # Plasma can own its D-Bus name while its scripting API is unresponsive.
  # Bound the entire qdbus call, including introspection, and escalate if needed.
  log_info "wallpaper: applying with KDE Plasma (5-second timeout)"
  timeout --kill-after=1s 5s qdbus6 org.kde.plasmashell /PlasmaShell \
    org.kde.PlasmaShell.evaluateScript "$plasma_script" >/dev/null
  result=$?
  case "$result" in
    0) return 0 ;;
    124|137) fail_module "wallpaper: KDE Plasma did not respond within 5 seconds" ;;
    *) fail_module "wallpaper: failed to set wallpaper with qdbus6" ;;
  esac
}

apply_wallpaper_macos() {
  wallpaper_path="$1"

  osascript - "$wallpaper_path" >/dev/null 2>&1 <<'EOF'
on run argv
  set wallpaperPath to item 1 of argv

  tell application "System Events"
    repeat with desktopItem in desktops
      set picture of desktopItem to wallpaperPath
    end repeat
  end tell
end run
EOF
}

apply_wallpaper() {
  theme="$1"

  # SSH forwarding is not a local desktop: the user bus still targets this host.
  if [ -n "${SSH_CONNECTION:-}${SSH_CLIENT:-}${SSH_TTY:-}" ]; then
    skip_module "wallpaper: SSH session; skipped"
    return $?
  fi
  # Herdr and other remote/headless shells may not preserve SSH variables.
  # A reachable user bus alone does not mean this shell has a graphical session.
  if is_linux && [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then
    skip_module "wallpaper: no graphical session (DISPLAY/WAYLAND_DISPLAY unset); skipped"
    return $?
  fi

  wallpaper_file="$(theme_value wallpaper "$theme")" || {
    skip_module "wallpaper: no file mapped for theme '$theme'; skipped"
    return $?
  }

  if [ -z "$wallpaper_file" ]; then
    skip_module "wallpaper: no file mapped for theme '$theme'; skipped"
    return $?
  fi
  if ! is_safe_name "$wallpaper_file"; then
    fail_module "wallpaper: invalid file mapping for theme '$theme'"
    return $?
  fi

  wallpapers_dir="${CHAMELEON_WALLPAPERS_DIR:-$HOME/Wallpapers}"
  wallpaper_path="$wallpapers_dir/$wallpaper_file"

  if [ ! -f "$wallpaper_path" ]; then
    fail_module "wallpaper: file not found: $wallpaper_path"
    return $?
  fi

  if is_linux; then
    apply_wallpaper_linux "$wallpaper_path" || return $?
  elif is_macos; then
    if ! apply_wallpaper_macos "$wallpaper_path"; then
      fail_module "wallpaper: failed to set wallpaper with osascript"
      return $?
    fi
  else
    skip_module "wallpaper: unsupported OS; skipped"
    return $?
  fi

  log_info "wallpaper: applied '$wallpaper_file'"
}

main() {
  if [ "${1:-}" != "apply" ] || [ "$#" -ne 2 ]; then
    printf 'Usage: wallpaper apply <theme>\n' >&2
    return 2
  fi

  apply_wallpaper "$2"
}

main "$@"
