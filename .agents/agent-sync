#!/usr/bin/env zsh

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: agent-sync [--dry-run]

Synchronize agent setup from this dotfiles repository:
  - .agents/skills -> ~/.agents/skills, ~/.codex/skills, ~/.claude/skills,
    and ~/.grok/skills (Pi reads shared skills from ~/.agents/skills)
  - .agents/prompts -> ~/.codex/prompts and ~/.claude/prompts, if prompt files exist
  - .agents/codex -> ~/.codex
  - .agents/claude/commands -> ~/.claude/commands
  - .agents/claude/roles -> ~/.claude/agents
  - .agents/claude/CLAUDE.md and settings.json -> ~/.claude
  - .pi -> ~/.pi

The sync copies files into place and overwrites matching files. Skill
directories are mirrored: a top-level skill in a skills destination that is not
in .agents/skills is moved to
${XDG_DATA_HOME:-~/.local/share}/agent-sync/removed-<timestamp>-<pid>/<agent>/.
Hidden entries (such as ~/.codex/skills/.system), plain files, and skills
listed one per line in ${XDG_CONFIG_HOME:-~/.config}/agent-sync/keep-skills
are left alone. Other destination-only files are not deleted.
EOF
}

die() {
  echo "agent-sync: $*" >&2
  exit 1
}

log() {
  echo "agent-sync: $*"
}

repo_root() {
  local script_path="${${(%):-%x}:A}"
  local script_dir="${script_path:h}"
  cd "$script_dir/.." && pwd
}

has_real_files() {
  local dir="$1"
  local file

  [[ -d "$dir" ]] || return 1

  for file in "$dir"/**/*(.N); do
    [[ "${file:t}" == "README.md" ]] && continue
    return 0
  done

  return 1
}

copy_path() {
  local src="$1"
  local dest="$2"

  [[ -e "$src" ]] || return 0

  if (( dry_run )); then
    log "would copy $src -> $dest"
    return 0
  fi

  mkdir -p "${dest:h}"
  cp -R "$src" "$dest"
}

copy_dir_contents() {
  local src="$1"
  local dest="$2"
  local item

  [[ -d "$src" ]] || return 0

  if (( dry_run )); then
    log "would sync $src/ -> $dest/"
    return 0
  fi

  mkdir -p "$dest"

  for item in "$src"/*(N) "$src"/.[!.]*(N); do
    cp -R "$item" "$dest"/
  done
}

prune_skills() {
  local src="$1"
  local dest="$2"
  local label="$3"
  local item name target

  [[ -d "$dest" ]] || return 0

  for item in "$dest"/*(N); do
    name="${item:t}"
    # Only directories or symlinks are skills; mv moves a symlink, not its target.
    [[ -L "$item" || -d "$item" ]] || continue
    [[ -d "$src/$name" ]] && continue
    (( ${keep_skills[(Ie)$name]} )) && continue

    if (( dry_run )); then
      log "would remove stale skill $item"
      continue
    fi

    target="$removed_dir/$label/$name"
    mkdir -p "${target:h}"
    mv "$item" "$target"
    log "removed stale skill $item -> $target"
  done
}

dry_run=0

while (( $# > 0 )); do
  case "$1" in
    --dry-run)
      dry_run=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown option '$1'"
      ;;
  esac
done

root="$(repo_root)"
agents_dir="$root/.agents"

[[ -d "$agents_dir" ]] || die "missing $agents_dir"

codex_home="${CODEX_HOME:-$HOME/.codex}"
agents_home="${AGENTS_HOME:-$HOME/.agents}"
claude_home="${CLAUDE_HOME:-$HOME/.claude}"
grok_home="${GROK_HOME:-$HOME/.grok}"
pi_home="${PI_HOME:-$HOME/.pi}"

log "source: $agents_dir"
log "codex:  $codex_home"
log "agents: $agents_home"
log "claude: $claude_home"
log "grok:   $grok_home"
log "pi:     $pi_home"

keep_file="${XDG_CONFIG_HOME:-$HOME/.config}/agent-sync/keep-skills"
keep_skills=()
if [[ -f "$keep_file" ]]; then
  # One name per line; strip CR/whitespace (CRLF files), drop blanks and # comments.
  keep_skills=(${${${(f)"$(<"$keep_file")"}//[[:space:]]/}:#\#*})
fi
removed_dir="${XDG_DATA_HOME:-$HOME/.local/share}/agent-sync/removed-$(date +%Y%m%d-%H%M%S)-$$"

repo_skills=("$agents_dir"/skills/*(/N))
(( $#repo_skills )) || die "no skills in $agents_dir/skills; refusing to prune"

prune_skills "$agents_dir/skills" "$agents_home/skills" agents
prune_skills "$agents_dir/skills" "$codex_home/skills" codex
prune_skills "$agents_dir/skills" "$claude_home/skills" claude
prune_skills "$agents_dir/skills" "$grok_home/skills" grok

copy_dir_contents "$agents_dir/skills" "$agents_home/skills"
copy_dir_contents "$agents_dir/skills" "$codex_home/skills"
copy_dir_contents "$agents_dir/skills" "$claude_home/skills"
copy_dir_contents "$agents_dir/skills" "$grok_home/skills"
# Pi also discovers ~/.agents/skills; a second copy causes name collisions.

if has_real_files "$agents_dir/prompts"; then
  copy_dir_contents "$agents_dir/prompts" "$codex_home/prompts"
  copy_dir_contents "$agents_dir/prompts" "$claude_home/prompts"
fi

copy_dir_contents "$agents_dir/codex" "$codex_home"

copy_dir_contents "$agents_dir/claude/commands" "$claude_home/commands"
copy_dir_contents "$agents_dir/claude/roles" "$claude_home/agents"
copy_path "$agents_dir/claude/CLAUDE.md" "$claude_home/CLAUDE.md"
copy_path "$agents_dir/claude/settings.json" "$claude_home/settings.json"

copy_dir_contents "$root/.pi" "$pi_home"

log "done"
