typeset -A THEME_WALLPAPERS
THEME_WALLPAPERS=(
  dayfox latch-2.png
  miasma 0-nature-of-fear.png
  latch latch-1.jpg
)

_theme_wallpaper() {
  local theme="$1"
  local wallpaper="${THEME_WALLPAPERS[$theme]}"
  local wallpaper_path="$HOME/Wallpapers/$wallpaper"

  if [[ -z "$wallpaper" ]]; then
    echo "wallpaper: no wallpaper mapped for theme '$theme'" >&2
    return 1
  fi

  if [[ ! -f "$wallpaper_path" ]]; then
    echo "wallpaper: '$wallpaper_path' not found" >&2
    return 1
  fi

  if [[ "$OSTYPE" == darwin* ]]; then
    swift - << EOF
import AppKit
let url = URL(fileURLWithPath: "$wallpaper_path")
for screen in NSScreen.screens {
    try? NSWorkspace.shared.setDesktopImageURL(url, for: screen, options: [:])
}
EOF
    echo "wallpaper: $wallpaper"
  elif [[ "$OSTYPE" == linux* ]]; then
    local qdbus_output=""

    if ! command -v qdbus6 >/dev/null 2>&1; then
      echo "wallpaper: qdbus6 not found" >&2
      return 1
    fi

    if ! qdbus_output="$(qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "
const ds = desktops();
for (const desktop of ds) {
  desktop.wallpaperPlugin = 'org.kde.image';
  desktop.currentConfigGroup = ['Wallpaper', 'org.kde.image', 'General'];
  desktop.writeConfig('Image', 'file://$wallpaper_path');
}
" 2>&1)"; then
      echo "$qdbus_output" >&2
      return 1
    fi

    echo "wallpaper: $wallpaper"
  fi
}

_theme_ghostty() {
  local theme="$1"
  local ghostty_themes="$HOME/.config/ghostty/themes"
  local ghostty_service="app-com.mitchellh.ghostty.service"

  if [[ ! -f "$ghostty_themes/$theme" ]]; then
    echo "ghostty: '$theme' not found, skipping"
    return 0
  fi

  cp "$ghostty_themes/$theme" "$ghostty_themes/current"

  if pgrep -x ghostty >/dev/null 2>&1; then
    if command -v systemctl >/dev/null 2>&1 && systemctl --user --quiet is-active "$ghostty_service"; then
      systemctl reload --user "$ghostty_service"
    else
      pkill -USR2 -x ghostty
    fi
  fi

  echo "ghostty: $theme"
}

_theme_btop() {
  local theme="$1"
  local btop_themes="$HOME/.config/btop/themes"
  local btop_conf="$HOME/.config/btop/btop.conf"

  if [[ -f "$btop_themes/$theme.theme" ]]; then
    perl -i -pe "s|^color_theme = .*|color_theme = \"$btop_themes/$theme.theme\"|" "$btop_conf"
    echo "btop: $theme"
  else
    echo "btop: '$theme' not found, skipping"
  fi
}

_theme_nvim() {
  local theme="$1"
  local nvim_plugins="$HOME/.config/nvim/lua/heorhi/plugins"
  local nvim_themes="$HOME/.config/nvim/lua/heorhi/themes"

  if [[ -f "$nvim_themes/$theme.lua" ]]; then
    cp "$nvim_themes/$theme.lua" "$nvim_plugins/colorscheme.lua"
    echo "neovim: $theme (restart nvim to apply)"
  else
    echo "neovim: '$theme' not found, skipping"
  fi
}

theme-switch() {
  local theme="$1"

  if [[ -z "$theme" ]]; then
    echo "Usage: theme-switch <theme-name>"
    return 1
  fi

  _theme_ghostty "$theme"
  _theme_btop "$theme"
  _theme_nvim "$theme"
  _theme_wallpaper "$theme"
}
